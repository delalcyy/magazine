# ─── Sunucu ─────────────────────────────
PORT=4000
NODE_ENV=development

# ─── CORS — frontend'in çalıştığı adres ─
CORS_ORIGIN=http://localhost:3000

# ─── JWT ─────────────────────────────────
# Production'da uzun ve rastgele bir string kullan
JWT_SECRET=ftv_super_secret_2025_change_in_production
JWT_EXPIRES_IN=7d

# ─── Veritabanı ──────────────────────────
DB_PATH=./database/fashiontv.sqlite

# ─── Gmail SMTP ──────────────────────────
# Google Hesabı > Güvenlik > 2 Adımlı Doğrulama açık olmalı
# Ardından: Google Hesabı > Güvenlik > Uygulama Şifreleri > Yeni şifre oluştur
GMAIL_USER=your@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# ─── Frontend URL (doğrulama maili linki için) ─
# HTML dosyaların açıldığı adres — file:// ile açıyorsanız boş bırakmayın,
# bir local server kullanın (örn: npx serve . -p 3000 → http://localhost:3000)
FRONTEND_URL=http://localhost:8080
